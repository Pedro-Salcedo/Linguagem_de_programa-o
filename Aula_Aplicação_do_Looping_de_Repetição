      }
    },
    {
      "cell_type": "code",
      "source": [
        "import random\n",
        "\n",
        "numeros_sorteados=random.sample(range(1,61),6)\n",
        "#Após sortear eu ordeno os números em ordem crescente\n",
        "numeros_sorteados.sort()\n",
        "print (\"Números sorteados:\")\n",
        "por numero in numero_sorteados:\n",
        "print (numero, end=\" \")"
